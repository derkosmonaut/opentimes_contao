{% extends "@Contao/content_element/_base.html.twig" %}

{% use "@Contao/component/_stylesheet.html.twig" %}

{% block content %}
  {# Grundstil mit den Farben für geöffnet/geschlossen; im Theme per CSS-Variablen anpassbar #}
  {% add "opentimes_css" to stylesheets %}
    {% with {file: asset('bundles/derkosmonautopentimes/css/opentimes.css')} %}
      {{ block('stylesheet_component') }}
    {% endwith %}
  {% endadd %}

  <div class="opentimes">
    {% include "@Contao/opentimes/_status.html.twig" %}

    {% if show_week and has_plan %}
      {% include "@Contao/opentimes/_week.html.twig" %}
    {% endif %}

    {% if show_json_ld and json_ld %}
      {% include "@Contao/opentimes/_json_ld.html.twig" %}
    {% endif %}
  </div>
{% endblock %}
