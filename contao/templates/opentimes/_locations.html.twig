{# Alle gewählten Orte mit aktuellem Status und den Zeiten von heute. Erwartet: entries, labels. #}
<ul class="opentimes__locations">
  {% for entry in entries %}
    <li class="opentimes__location">
      <strong class="opentimes__location-title">{{ entry.location.title }}</strong>
      {% if entry.location.city %}<span class="opentimes__location-city">{{ entry.location.city }}</span>{% endif %}
      {% include "@Contao/opentimes/_status.html.twig" with {status: entry.status, location: entry.location} %}
      {% if entry.has_plan and entry.today %}
        <p class="opentimes__today-hours">
          {{ labels.today_hours }}:
          {% if entry.today.closed %}
            {{ labels.closed }}
          {% else %}
            {% for window in entry.today.windows %}<span class="opentimes__window"><time>{{ window.opens }}</time> {{ labels.to }} <time>{{ window.closes }}</time> {{ labels.time_suffix }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
          {% endif %}
        </p>
      {% endif %}
    </li>
  {% endfor %}
</ul>
