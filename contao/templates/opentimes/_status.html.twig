{# Aktueller Status. Erwartet: status (Resolver\Model\Status), labels, location.
   Klassen: opentimes__status--open | --closed | --unknown (Farben siehe opentimes.css) #}
<p class="opentimes__status opentimes__status--{{ status.state }}">
  {% if status.state == 'open' %}
    <strong>{{ labels.status.open_until }} {{ status.until|date('H:i') }} {{ labels.time_suffix }}</strong>
  {% elseif status.state == 'closed' %}
    <strong>{{ labels.status.closed }}</strong>
    {% if status.message %}
      <span class="opentimes__message">{{ status.message }}</span>
    {% endif %}
    {% if status.nextOpen %}
      <span class="opentimes__next">
        {{ labels.status.opens_again }} {{ status.nextOpen|date('d.m.Y, H:i') }} {{ labels.time_suffix }}
      </span>
    {% endif %}
  {% else %}
    <strong>{{ labels.status.unknown }}</strong>
  {% endif %}
</p>
