{# Zeitübersicht: Standard, Saisonzeiten, Ausnahmen und Feiertage auf einen Blick.
   Erwartet: overview (aus Output\OverviewBuilder), location, labels. #}
{% macro groups(groups, labels) %}
  <dl class="opentimes__overview-list">
    {% for group in groups %}
      <dt>{{ group.days }}</dt>
      <dd{% if group.closed %} class="opentimes__overview-closed"{% endif %}>
        {% if group.closed %}
          {{ labels.closed }}
        {% else %}
          {% for window in group.windows %}<span class="opentimes__window"><time>{{ window.opens }}</time> {{ labels.to }} <time>{{ window.closes }}</time> {{ labels.time_suffix }}{% if window.overnight %} <small>({{ labels.overnight }})</small>{% endif %}</span>{% if not loop.last %}, {% endif %}{% endfor %}
        {% endif %}
      </dd>
    {% endfor %}
  </dl>
{% endmacro %}

<div class="opentimes__overview">
  {% for block in overview.blocks %}
    <section class="opentimes__overview-block{{ block.current ? ' opentimes__overview-block--current' }}">
      <span class="opentimes__overview-title">
        {% if block.kind == 'standard' %}
          {{ block.title ?: labels.overview_standard }}
        {% else %}
          {{ block.title ?: labels.overview_season }}
          <span class="opentimes__overview-period">
            {% if block.recurring %}
              <time>{{ block.start|date('d.m.') }}</time> {{ labels.overview_until }} <time>{{ block.stop|date('d.m.') }}</time>, {{ labels.overview_yearly }}
            {% else %}
              <time datetime="{{ block.start|date('Y-m-d') }}">{{ block.start|date('d.m.Y') }}</time> {{ labels.overview_until }} <time datetime="{{ block.stop|date('Y-m-d') }}">{{ block.stop|date('d.m.Y') }}</time>
            {% endif %}
          </span>
        {% endif %}
        {% if block.current %}<span class="opentimes__badge">{{ labels.overview_current }}</span>{% endif %}
      </span>
      {{ _self.groups(block.groups, labels) }}
    </section>
  {% endfor %}

  <section class="opentimes__overview-block">
    <span class="opentimes__overview-title">{{ labels.overview_upcoming }}</span>
    {% if overview.upcoming is empty %}
      <p class="opentimes__overview-note">{{ labels.overview_none }}</p>
    {% else %}
      <dl class="opentimes__overview-list">
        {% for item in overview.upcoming %}
          <dt>
            <time datetime="{{ item.start|date('Y-m-d') }}">{{ item.start|date('d.m.Y') }}</time>
            {% if item.stop %} {{ labels.overview_until }} <time datetime="{{ item.stop|date('Y-m-d') }}">{{ item.stop|date('d.m.Y') }}</time>{% endif %}
          </dt>
          <dd{% if item.closed %} class="opentimes__overview-closed"{% endif %}>
            {% if item.title %}{{ item.title }}: {% elseif item.kind == 'holiday' %}{{ labels.overview_holiday }}: {% endif %}
            {% if item.closed %}
              {{ labels.closed }}
            {% else %}
              {% for window in item.windows %}<span class="opentimes__window"><time>{{ window.opens }}</time> {{ labels.to }} <time>{{ window.closes }}</time> {{ labels.time_suffix }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
            {% endif %}
          </dd>
        {% endfor %}
      </dl>
      <p class="opentimes__overview-note">{{ labels.overview_upcoming_until }} {{ overview.until|date('d.m.Y') }}</p>
    {% endif %}
  </section>
</div>
